/*
 * Temporarily here because nice nano v2 spi is not defined on ZMK Yet
 * Source: https://github.com/zmkfirmware/zmk/blob/main/app/boards/shields/reviung41/boards/nice_nano.overlay
 * GitHub Issue: https://github.com/zmkfirmware/zmk/issues/885
 */

#include <dt-bindings/led/led.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // default: 600

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&pinctrl {
    spi3_default: spi3_default {
        group1 { psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>; };
    };

    spi3_sleep: spi3_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 0, 8)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";
    pinctrl-0 = <&spi3_default>;
    pinctrl-1 = <&spi3_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        label = "WS2812";

        /* SPI */

        reg = <0>; /* ignored, but necessary for SPI bindings */
        spi-max-frequency = <4000000>;

        /* WS2812 */

        chain-length = <30>;
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;
        color-mapping = <LED_COLOR_ID_GREEN LED_COLOR_ID_RED LED_COLOR_ID_BLUE>;
    };
};

&mmv { time-to-max-speed-ms = <500>; };

/ {
    chosen { zmk,underglow = &led_strip; };
};

/* END temporary RGB support section */

/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp GRAVE  &kp N1  &kp N2    &kp N3    &kp N4     &kp N5                                     &kp N6  &kp N7     &kp N8     &kp N9    &kp N0    &kp C_PLAY_PAUSE
&kp ESC    &kp Q   &kp W     &kp E     &kp R      &kp T                                      &kp Y   &kp U      &kp I      &kp O     &kp P     &kp F13
&kp TAB    &kp A   &kp S     &kp D     &kp F      &kp G                                      &kp H   &kp J      &kp K      &kp L     &kp SEMI  &kp APOSTROPHE
&kp LSHFT  &kp Z   &kp X     &kp C     &kp V      &kp B   &kp LEFT_SHIFT    &kp RIGHT_SHIFT  &kp N   &kp M      &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                   &kp LGUI  &kp LALT  &kp LCTRL  &mo 3   &lt 1 SPACE       &kp BACKSPACE    &mo 4   &kp RCTRL  &kp RALT   &kp RGUI
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        space_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                       &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans  &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &kp ENTER  &trans  &trans  &trans  &trans
            >;
        };

        gaming_layer {
            bindings = <
&trans  &kp N5  &kp N1   &kp N2  &kp N3        &kp N4                          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp T   &kp Q    &kp W   &kp E         &kp R                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp G   &kp A    &kp S   &kp D         &kp F                           &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp B   &kp Z    &kp X   &kp C         &kp V      &trans       &trans  &trans  &trans  &trans  &trans  &trans  &trans
                &kp F13  &mo 3   &kp LEFT_ALT  &kp LCTRL  &kp SPACE    &trans  &tog 2  &trans  &trans  &trans
            >;
        };

        lower_layer {
            bindings = <
&trans     &trans       &trans      &trans                &trans                 &trans                                     &trans        &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans           &trans
&kp GRAVE  &kp EXCL     &kp AT      &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp PIPE                                   &kp KP_PLUS   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp BACKSLASH    &trans
&trans     &kp HASH     &kp DOLLAR  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp AMPERSAND                              &kp EQUAL     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_MULTIPLY  &trans
&trans     &kp PERCENT  &kp CARET   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDER      &caps_word    &kp CAPSLOCK  &kp KP_MINUS  &kp KP_NUMBER_0  &trans           &trans           &kp SLASH        &trans
                        &trans      &trans                &trans                 &trans         &trans        &kp DELETE    &trans        &trans           &trans           &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        raise_layer {
            bindings = <
&kp F12  &kp F1  &kp F2          &kp F3          &kp F4           &kp F5                              &kp F6            &kp F7      &kp F8             &kp F9           &kp F10        &kp F11
&trans   &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_UP                        &kp PG_UP         &kp HOME    &kp UP             &kp END          &trans         &trans
&trans   &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp MB3                            &kp PG_DN         &kp LEFT    &kp DOWN           &kp RIGHT        &kp BACKSPACE  &kp DELETE
&trans   &trans  &trans          &trans          &trans           &msc SCRL_DOWN  &mkp MB2    &trans  &kp C_PLAY_PAUSE  &kp C_MUTE  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp F13        &trans
                 &trans          &trans          &trans           &trans          &mkp MB1    &trans  &trans            &trans      &trans             &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        tri_layer {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4                    &trans  &trans  &trans   &trans   &trans   &trans
&trans      &rgb_ug RGB_SPD  &rgb_ug RGB_SAI  &rgb_ug RGB_HUI  &rgb_ug RGB_BRI  &trans                          &trans  &trans  &trans   &trans   &trans   &trans
&trans      &rgb_ug RGB_SPD  &rgb_ug RGB_SAD  &rgb_ug RGB_HUD  &rgb_ug RGB_BRD  &tog 2                          &trans  &trans  &kp F13  &kp F14  &kp F15  &kp F16
&trans      &trans           &trans           &rgb_ug RGB_EFF  &rgb_ug RGB_TOG  &trans        &trans    &trans  &trans  &trans  &trans   &trans   &trans   &trans
                             &trans           &trans           &trans           &trans        &trans    &trans  &trans  &trans  &trans   &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer_conditional {
            if-layers = <3 4>;
            then-layer = <5>;
        };
    };
};
